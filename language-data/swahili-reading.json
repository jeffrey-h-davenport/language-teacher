    {
      "id": "p002",
      "cefr": "A1",
      "text": "Yeye anawapenda mbwa wake. Ana mbwa jike mkubwa mwenye manyoya marefu meupe. Pia ana mbwa dume mdogo mwenye manyoya mafupi ya kahawia. Mbwa jike ni mdogo kwa umri kuliko mbwa dume.",
      "questions": [
        {
          "question": "Ana mbwa wangapi?",
          "choices": [
            "Mmoja",
            "Watatu",
            "Wawili",
            "Wanne"
          ],
          "answer": 2
        },
        {
          "question": "Manyoya ya mbwa jike yana rangi gani?",
          "choices": [
            "Meupe",
            "Ya kahawia",
            "Meusi",
            "Ya kijivu"
          ],
          "answer": 0
        },
        {
          "question": "Mbwa dume yukoje?",
