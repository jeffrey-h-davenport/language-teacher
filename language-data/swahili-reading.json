        {
          "question": "Yeye huenda shuleni na marafiki zake lini?",
          "choices": [
            "Kila Jumatatu",
            "Kila Ijumaa",
            "Kila Jumapili",
            "Kila siku"
          ],
          "answer": 1
        },
        {
          "question": "Wao huendaje shuleni?",
