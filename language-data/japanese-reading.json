            "車で",
            "自転車で",
            "歩いて"
          ],
          "answer": 3
        },
        {
          "question": "店で何を買いますか。",
          "choices": [
            "炭酸飲料とポテトチップス",
            "パンと牛乳",
            "果物とジュース",
            "コーヒーとケーキ"
          ],
          "answer": 0
        },
        {
          "question": "どこで食べたり飲んだりしますか。",
          "choices": [
            "学校で",
            "家で",
            "学校へ行く途中で",
            "店の中で"
          ],
          "answer": 2
        }
      ],
