    {
      "id": "p001",
      "cefr": "A1",
      "text": "По п'ятницях він ходить до школи з друзями. Вони йдуть до школи пішки повз магазин. Вони завжди заходять туди й купують газовану воду та чипси. Вони їдять і п'ють дорогою до школи.",
      "questions": [
        {
          "question": "Коли він ходить до школи з друзями?",
          "choices": [
            "По понеділках",
            "По п'ятницях",
            "По неділях",
            "Щодня"
          ],
          "answer": 1
        },
        {
          "question": "Як вони добираються до школи?",
          "choices": [
            "Автобусом",
            "Машиною",
            "Велосипедом",
            "Пішки"
          ],
          "answer": 3
        },
        {
          "question": "Що вони купують у магазині?",
          "choices": [
            "Газовану воду та чипси",
            "Хліб і молоко",
            "Фрукти й сік",
            "Каву й торт"
          ],
          "answer": 0
        },
        {
          "question": "Де вони їдять і п'ють?",
          "choices": [
            "У школі",
            "Удома",
            "Дорогою до школи",
            "У магазині"
          ],
          "answer": 2
        }
      ],
