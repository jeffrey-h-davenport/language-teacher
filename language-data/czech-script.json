      "table": {
        "columns": [
          "Case",
          "Question",
          "Main uses",
          "Example"
        ],
        "rows": [
          [
            "1 Nominative",
            "kdo? co?",
            "the subject; after být (to je…)",
            "Žena čte. (The woman is reading.)"
          ],
          [
            "2 Genitive",
            "koho? čeho?",
            "'of'; quantities; after z, do, od, u, bez",
            "bez cukru (without sugar)"
          ],
          [
            "3 Dative",
            "komu? čemu?",
            "'to / for' someone; after k, díky, proti",
            "Dám to ženě. (I'll give it to the woman.)"
          ],
          [
            "4 Accusative",
            "koho? co?",
            "the direct object; after pro, přes; na / za with movement",
            "Vidím ženu. (I see the woman.)"
          ],
          [
            "5 Vocative",
            "—",
            "calling or addressing someone",
            "Pane! Jano! (Sir! Jana!)"
          ],
          [
            "6 Locative",
            "o kom? o čem?",
            "only after v, na, o, po, při",
            "v Praze (in Prague), o filmu (about the film)"
          ],
          [
            "7 Instrumental",
            "kým? čím?",
            "'with' or 'by means of'; after s, za, před, nad, pod, mezi",
            "s kamarádem (with a friend), autem (by car)"
          ]
        ]
