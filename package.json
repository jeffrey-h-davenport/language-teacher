{
  "name": "language-teacher",
  "version": "1.14.13",
  "description": "Language learning app for macOS",
  "main": "app/main.js",
  "scripts": {
    "start": "ELECTRON_RUN_AS_NODE= electron .",
    "edit": "ELECTRON_RUN_AS_NODE= LT_EDITOR=1 electron .",
    "dist": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.languageteacher.app",
    "productName": "Language Teacher",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "app/**/*",
      "language-data/**/*",
      "package.json",
      "CHANGELOG.md",
      "!language-data/*-progress.json"
    ],
    "asar": false,
    "mac": {
      "category": "public.app-category.education",
      "target": "dmg",
      "icon": "assets/icon.icns"
    }
  }
}
